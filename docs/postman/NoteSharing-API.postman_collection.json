{
  "info": {
    "_postman_id": "8f0f3a2e-1b6c-4d5e-9a7b-2c3d4e5f6a7b",
    "name": "NoteSharing API v1 - pagination-free lists",
    "description": "Exercises the whole NoteSharing API over real HTTP, with emphasis on the nine list endpoints that stopped paginating on 2026-10-17.\n\nHOW TO USE\n1. Start the dev app:  .\\mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=dev\n2. Import this file, then run the whole collection with the Collection Runner, or run the folders in order.\n3. Folders 0 and 1 must run first: they register throwaway users and seed notes, shares, friend requests and a block, so the list endpoints in folder 2 return data instead of empty arrays.\n\nThe collection captures the access token automatically, so no manual copy-paste. All seeded entities are named with a per-run suffix that is regenerated at the start of every run, so you can re-run the whole collection as many times as you like.\n\nNOTES ON THE CHANGE\nEvery list endpoint now returns ApiResponse<List<T>>: a JSON array under 'data', not a {content,page,size,totalElements,totalPages} object. Ordering is fixed per endpoint. Legacy ?page=/?size= parameters are accepted and ignored rather than rejected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Regenerate the per-run suffix at the start of each run, so re-running the",
          "// collection always seeds fresh users instead of colliding on usernames.",
          "if (pm.info.requestName === 'Register me (captures token)') {",
          "  pm.collectionVariables.set('suffix', Date.now().toString().slice(-6) + Math.floor(Math.random() * 1000));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "suffix", "value": "" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "peer_a_token", "value": "" },
    { "key": "peer_b_token", "value": "" },
    { "key": "peer_c_token", "value": "" },
    { "key": "peer_d_token", "value": "" },
    { "key": "peer_a_id", "value": "" },
    { "key": "peer_b_id", "value": "" },
    { "key": "peer_c_id", "value": "" },
    { "key": "peer_d_id", "value": "" },
    { "key": "peerNoteId", "value": "" },
    { "key": "note1Id", "value": "" },
    { "key": "note2Id", "value": "" },
    { "key": "requestId", "value": "" }
  ],
  "item": [
    {
      "name": "0 - Setup and auth",
      "item": [
        {
          "name": "Register me (captures token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const d = body.data;",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('access token returned', () => pm.expect(d.accessToken).to.be.a('string').and.to.have.length.above(10));",
                  "pm.collectionVariables.set('token', d.accessToken);",
                  "pm.collectionVariables.set('refreshToken', d.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"me_{{suffix}}\",\n  \"email\": \"me_{{suffix}}@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Public endpoint. Creates the caller whose lists folder 2 reads."
          }
        },
        {
          "name": "Login (re-issue token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', d.accessToken);",
                  "pm.collectionVariables.set('refreshToken', d.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"me_{{suffix}}@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login is by email, not username. Re-runs the token capture if the access token expired."
          }
        },
        {
          "name": "Who am I (captures userId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userId', d.id);",
                  "pm.test('userId captured', () => pm.expect(pm.collectionVariables.get('userId')).to.not.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "description": "Bearer token comes from the collection auth. Needed so peers can address the caller by id."
          }
        }
      ]
    },
