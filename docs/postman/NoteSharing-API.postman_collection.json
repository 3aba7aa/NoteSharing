        {
          "name": "Resolve peer ids (search + map)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "const suffix = pm.collectionVariables.get('suffix');",
                  "pm.test('search returned an array', () => pm.expect(d).to.be.an('array'));",
                  "pm.test('all four peers found', () => pm.expect(d).to.have.length(4));",
                  "for (const k of ['a', 'b', 'c', 'd']) {",
                  "  const row = d.find(r => r.username === 'peer_' + suffix + '_' + k);",
                  "  if (row) pm.collectionVariables.set('peer_' + k + '_id', row.id);",
                  "}",
                  "pm.test('peer ids resolved', () => {",
                  "  for (const k of ['a', 'b', 'c', 'd']) {",
                  "    pm.expect(pm.collectionVariables.get('peer_' + k + '_id'), k).to.not.be.empty;",
                  "  }",
                  "});"
