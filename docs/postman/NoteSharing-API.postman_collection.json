    {
      "name": "2 - The nine list endpoints (changed)",
      "item": [
        {
          "name": "GET /notes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('data is an array', () => pm.expect(d).to.be.an('array'));",
                  "pm.test('no pagination metadata', () => {",
                  "  pm.expect('content' in d).to.be.false;",
                  "  pm.expect('totalElements' in d).to.be.false;",
                  "});",
                  "pm.test('newest first', () => {",
                  "  const c = d.map(n => n.createdAt);",
                  "  pm.expect(c).to.eql([...c].sort().reverse());",
                  "});",
                  "pm.test('summary omits the body', () => {",
                  "  if (d.length) pm.expect('content' in d[0]).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/notes",
            "description": "My own notes, newest first. Filters: type, visibility, from, to are all optional."
          }
        },
        {
          "name": "GET /notes/shared",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('data is an array', () => pm.expect(d).to.be.an('array'));",
                  "pm.test('no pagination metadata', () => {",
                  "  pm.expect('content' in d).to.be.false;",
                  "  pm.expect('totalElements' in d).to.be.false;",
                  "});",
                  "pm.test('contains the note peer a shared', () => {",
                  "  pm.expect(d.map(n => n.title)).to.include(\"Peer a's note\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/notes/shared",
            "description": "Notes other people shared WITH me (not notes I shared out), newest first."
          }
        },
        {
          "name": "GET /notes/public",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
