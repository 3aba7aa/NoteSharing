                  "pm.test('no pagination metadata', () => {",
                  "  pm.expect('content' in d).to.be.false;",
                  "  pm.expect('totalElements' in d).to.be.false;",
                  "});",
                  "pm.test('excludes my own note', () => {",
                  "  pm.expect(d.map(n => n.title)).to.not.include('My public note');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/notes/public",
            "description": "Other people's PUBLIC notes only. My own notes are excluded even when they are public."
          }
        },
        {
          "name": "GET /users/search?q=",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('data is an array', () => pm.expect(d).to.be.an('array'));",
                  "pm.test('no pagination metadata', () => {",
                  "  pm.expect('content' in d).to.be.false;",
                  "  pm.expect('totalElements' in d).to.be.false;",
                  "});",
                  "pm.test('username ascending', () => {",
                  "  const u = d.map(x => x.username);",
                  "  pm.expect(u).to.eql([...u].sort());",
                  "});",
                  "pm.test('summary is id + username only', () => {",
                  "  if (d.length) pm.expect(Object.keys(d[0]).sort()).to.eql(['id', 'username']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/search?q={{suffix}}",
            "description": "Matches me and all four peers, so the result is non-empty. Usernames come back ascending."
          }
        },
        {
          "name": "GET /users/search (missing q -> 400)",
          "event": [
