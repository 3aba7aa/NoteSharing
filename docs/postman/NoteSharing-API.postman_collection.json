              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/notifications",
            "description": "Optional filters: read, type. Note that ?read=true means notifications whose read flag IS true (i.e. read), not 'unread only'."
          }
        },
        {
          "name": "GET /users/me/friends",
          "event": [
