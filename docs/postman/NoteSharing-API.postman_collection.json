                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/search",
            "description": "The bundled bug fix: a missing q used to raise an unhandled MissingServletRequestParameterException and surface as 500. It is now a 400 business-rule violation."
          }
        },
